   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WIREFRAME NOTE \u2014 this slide is diagram-led, not prose-led. Same skeleton both halves: PAIN (red label) \u2192 SOLUTION (green band) \u2192 mechanism flow \u2192 result strip. The 109.9% gold box is the single takeaway.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",

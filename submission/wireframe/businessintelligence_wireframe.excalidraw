   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The pause is a REAL interrupt on a durable checkpoint \u2014 resuming gives the same run with an\nidentical bundle hash. Only HIGH clears the ten-case floor; MEDIUM and LOW report UNCALIBRATED.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "The pause is a REAL interrupt on a durable checkpoint \u2014 resuming gives the same run with an\nidentical bundle hash. Only HIGH clears the ten-case floor; MEDIUM and LOW report UNCALIBRATED.",

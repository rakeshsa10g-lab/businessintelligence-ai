   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2014 Sparse history breaks naive baselines \u2014 new categories have no seasonal profile.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "\u2014 Sparse history breaks naive baselines \u2014 new categories have no seasonal profile.",

   "versionNonce": 1167889501,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2192 Six typed reasons to stop \u2014 sparse history, conflicting evidence, access denied, data quality, insufficient evidence, clarification needed \u2014 not one generic \"no results\" screen.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 10,
   "containerId": null,
   "originalText": "\u2192 Six typed reasons to stop \u2014 sparse history, conflicting evidence, access denied, data quality, insufficient evidence, clarification needed \u2014 not one generic \"no results\" screen.",

   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  No tool says when it doesn't know.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "1  No tool says when it doesn't know.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e115_2848",
   "type": "text",
   "x": 3272,
   "y": 240,
   "width": 680,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#5f6070",
   "backgroundColor": "transparent",

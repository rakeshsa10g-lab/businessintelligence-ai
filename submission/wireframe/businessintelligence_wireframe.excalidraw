   "versionNonce": 1061107691,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2014 Statistical significance \u2260 business significance. A real 0.4% move is not worth a Monday.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "\u2014 Statistical significance \u2260 business significance. A real 0.4% move is not worth a Monday.",
   "lineHeight": 1.25,
   "autoResize": true
  },

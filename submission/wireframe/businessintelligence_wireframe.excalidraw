  {
   "id": "e305_6346",
   "type": "text",
   "x": 3126,
   "y": 2016,
   "width": 826,
   "height": 48.8,
   "angle": 0,
   "strokeColor": "#1b1b25",
   "backgroundColor": "transparent",

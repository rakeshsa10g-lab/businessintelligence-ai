   "versionNonce": 280599242,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2014 Correlation presented as causation \u2014 two series moving together is not evidence.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "\u2014 Correlation presented as causation \u2014 two series moving together is not evidence.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {

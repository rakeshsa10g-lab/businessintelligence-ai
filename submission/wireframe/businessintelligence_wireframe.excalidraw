   "versionNonce": 450024946,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every one of them always renders an answer.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "Every one of them always renders an answer.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e116_2377",
   "type": "text",
   "x": 3272,
   "y": 268,
   "width": 680,
   "height": 15.0,
   "angle": 0,

   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2014 Noise looks like signal \u2014 alerts fire on fluctuation and train people to ignore them.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "\u2014 Noise looks like signal \u2014 alerts fire on fluctuation and train people to ignore them.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e243_8787",
   "type": "text",
   "x": 2160,
   "y": 1542,
   "width": 860,
   "height": 17.5,
   "angle": 0,

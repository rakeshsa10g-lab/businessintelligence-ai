   "seed": 278331463,
   "version": 1,
   "versionNonce": 1701105973,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Conversion rate accounts for 109.9% \u2014 MORE than the whole movement \u2014 because sessions\nrose and partly offset it. An exact identity closes to zero, so the system explains the\nfigure rather than clipping it.  No language model generates a self-explaining share above 100%.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "Conversion rate accounts for 109.9% \u2014 MORE than the whole movement \u2014 because sessions\nrose and partly offset it. An exact identity closes to zero, so the system explains the\nfigure rather than clipping it.  No language model generates a self-explaining share above 100%.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e306_5123",
